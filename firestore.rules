rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /*
     * ============================================================
     * BEAN & BLOOM CAFÉ — FIRESTORE SECURITY RULES
     * ============================================================
     *
     * Customer:
     *   - Can create a reservation.
     *   - Cannot read reservations.
     *   - Cannot modify reservation status.
     *   - Cannot delete reservations.
     *
     * Administrator:
     *   - Can read reservations.
     *   - Can update reservation status.
     *   - Can delete reservations.
     *
     * IMPORTANT:
     * Change the admin email below if your Firebase
     * Authentication administrator account uses another email.
     * ============================================================
     */

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@beanandbloom.com';
        //&& request.auth.token.email_verified == true
    }


    match /reservations/{reservationId} {

      /*
       * ==========================================================
       * READ
       * ==========================================================
       *
       * Only the Bean & Bloom administrator can view reservations.
       */
      allow read: if isAdmin();


      /*
       * ==========================================================
       * CREATE
       * ==========================================================
       *
       * Public customers can create reservations.
       *
       * Required fields:
       *   name
       *   email
       *   date
       *   time
       *   guests
       *   status
       *
       * Customers must create the reservation with status "pending".
       *
       * The additional fields below are allowed because the
       * Bean & Bloom frontend may store reservation information
       * such as phone, special requests and timestamps.
       */
      allow create: if

        // Name
        request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100

        // Email
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 150
        && request.resource.data.email.matches('.*@.*')

        // Date
        && request.resource.data.date is string
        && request.resource.data.date.size() >= 1
        && request.resource.data.date.size() <= 30

        // Time
        && request.resource.data.time is string
        && request.resource.data.time.size() >= 1
        && request.resource.data.time.size() <= 30

        // Guests
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 20

        // Customers can only create pending reservations
        && request.resource.data.status == 'pending';


      /*
       * ==========================================================
       * UPDATE
       * ==========================================================
       *
       * Only the administrator can update reservations.
       *
       * The administrator can change status to:
       *   pending
       *   confirmed
       *   cancelled
       */
      allow update: if
        isAdmin()
        && request.resource.data.status
           in ['pending', 'confirmed', 'cancelled'];


      /*
       * ==========================================================
       * DELETE
       * ==========================================================
       *
       * Only the administrator can delete reservations.
       */
      allow delete: if isAdmin();
    }
  }
}